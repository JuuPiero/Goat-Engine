; GoatEngine reflective vertex shader for the PICA200: like standard.v.pica, plus the world-space
; reflection vector in texcoord0 (+ texcoord0w) for a cube map on texture unit 0; the base
; texture moves to unit 1 (texcoord1 = uv).
; Feeds the GPU's fragment lighting (per-pixel Lambert + Blinn-Phong in hardware): it outputs the
; view vector and the normal as a quaternion; color = vertex color, texcoord0 = texcoord1 = uv
; (unit 0: base texture, unit 1: emissive map).
; Attributes: v0 position, v1 normal, v2 uv, v3 color (goat_gfx::Vertex layout).

.fvec projection[4], modelView[4], viewInv[3]

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy
.alias  half  myconst.wwww

.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outtc1 texcoord1
.out outclr color
.out outview view
.out outnq normalquat

.alias inpos v0
.alias innrm v1
.alias intex v2
.alias inclr v3

.proc main
	; r0 = (position, 1)
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * position (view space)
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; view vector = vertex → eye
	mov outview, -r1

	; clip position
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc1, intex
	mov outclr, inclr

	; view-space normal, normalized
	dp3 r14.x, modelView[0], innrm
	dp3 r14.y, modelView[1], innrm
	dp3 r14.z, modelView[2], innrm
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	; reflection: I = normalized eye→vertex (view space), R = I - 2 (N·I) N, to world space
	dp3 r7.x, r1, r1
	rsq r7.x, r7.x
	mul r7.xyz, r1.xyz, r7.x
	dp3 r8.x, r14, r7
	add r8.x, r8.x, r8.x
	mul r9.xyz, r14.xyz, r8.x
	add r9.xyz, r7.xyz, -r9.xyz
	dp3 r10.x, viewInv[0], r9
	dp3 r10.y, viewInv[1], r9
	dp3 r10.z, viewInv[2], r9
	mov outtc0, r10.xyyy
	mov outtc0w, r10.zzzz

	; quaternion rotating +Z onto the normal: (n.xy / (2c), c, 0), c = sqrt((1 + n.z) / 2)
	mov r0, myconst.yxxx
	add r4, ones, r14.z
	mul r4, half, r4
	cmp zeros, ge, ge, r4.x
	rsq r4, r4.x
	mul r5, half, r14
	jmpc cmp.x, degenerate

	rcp r0.z, r4.x
	mul r0.xy, r5, r4

degenerate:
	mov outnq, r0
	end
.end
