; GoatEngine outline vertex shader for the PICA200: the mesh pushed out along its view-space
; normals by `outline.x` units; the color comes from the texture combiner (a constant).

.fvec projection[4], modelView[4], outline

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  ones  myconst.yyyy

.out outpos position
.out outclr color

.alias inpos v0
.alias innrm v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	; view-space position
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; view-space normal, normalized, ? width
	dp3 r2.x, modelView[0], innrm
	dp3 r2.y, modelView[1], innrm
	dp3 r2.z, modelView[2], innrm
	dp3 r3.x, r2, r2
	rsq r3.x, r3.x
	mul r2.xyz, r2.xyz, r3.x
	mul r2.xyz, outline.xxxx, r2.xyz
	add r1.xyz, r1.xyz, r2.xyz

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outclr, ones
	end
.end
