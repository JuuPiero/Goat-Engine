<Project Sdk="Microsoft.NET.Sdk">
  <!-- goat-cs: C# scripts → ES modules for GoatEngine's JavaScript host (Roslyn). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>goat-cs</AssemblyName>
    <RootNamespace>GoatCs</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- the API scripts compile against (also copied into projects for IDEs) -->
    <EmbeddedResource Include="Api\GoatEngine.cs" LogicalName="GoatEngine.cs" />
    <Compile Remove="Api\**" />
    <Compile Remove="tests\**" />
  </ItemGroup>
</Project>
